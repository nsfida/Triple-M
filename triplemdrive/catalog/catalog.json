  "faq": [
    {
      "q": "How do I book a car?",
      "a": "Choose a car or a price and tap Book. Fill in the short form and send it. We contact you to confirm your reservation."
    },
    {
      "q": "Do I pay online?",
      "a": "No. Nothing is charged online; payment is arranged directly with us."
    },
    {
      "q": "I need an invoice. Is anything added?",
      "a": "Yes. If you need an invoice, 15% is applied on the final invoice."
    },
    {
      "q": "Can I pay in cash?",
      "a": "Yes. Cash payment is 5% on the final invoice."
    },
    {
      "q": "Can I pay by transfer to an individual account?",
      "a": "Yes, 0% is added; payment is in advance."
    },
    {
      "q": "How early should I book?",
      "a": "At least 1 hour before the trip."
    },
    {
      "q": "How do I share my pickup location?",
      "a": "Pick it on the map in the booking form, or send your location to our WhatsApp number after payment."
    },
    {
      "q": "When are you available?",
      "a": "24/7, every day."
    },
    {
      "q": "How do I make a complaint?",
      "a": "On WhatsApp only, with a picture, or by the official Triplem email."
    },
    {
      "q": "Who do I contact in an emergency?",
      "a": "Email the official Triplem email."
    }
  ]
